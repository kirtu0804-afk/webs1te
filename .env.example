# Set to production when deploying. Debug behavior is disabled unless explicitly enabled by the host.
NODE_ENV=production

# Port used by the Express server. This is not a secret.
PORT=4173

# Required in production. Use an absolute path on persistent storage.
DATA_DIRECTORY=C:\\path\\to\\mori-cafe-data

# Required in production. Must be the HTTPS origin serving the frontend, with no trailing slash.
FRONTEND_ORIGIN=https://your-domain.example

# Required in production to use operator-only reset and export endpoints. Keep server-side only.
ADMIN_API_TOKEN=replace-with-a-long-random-value
